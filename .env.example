# Copy to .env for Docker Compose, and replace every CHANGE_ME value.
DATABASE_PASSWORD=CHANGE_ME_database_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=CHANGE_ME_admin_password_at_least_12_characters
# Set true when serving the combined application over HTTPS.
COOKIE_SECURE=false
